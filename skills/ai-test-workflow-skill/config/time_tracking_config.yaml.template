# 时间节省追踪配置
# 控制时间追踪的存储模式、参考时间、MySQL 集中存储对接
#
# ⚠️ 这是模板文件。使用前请复制为 time_tracking_config.yaml 并填写实际连接信息：
#   cp time_tracking_config.yaml.template time_tracking_config.yaml

# ============================================================
# 存储模式
# ============================================================
# local:  仅本地 JSONL（无集中存储）
# mysql:  本地 JSONL + MySQL 数据库（多测试人员实时同步，推荐）
# 跨业务线共享：所有业务线的测试专家写入同一张 time_tracking 表，
# 通过 biz_line（中文名）和 biz_line_code（编码）区分。
storage_mode: "mysql"

# 业务线标识（本专家归属的业务线，其他业务线专家需修改此处）
biz_line: "效贷"
biz_line_code: "XD"
# 编码枚举：XD=效贷, JWY=泾渭云, XR=效融, XXD=小贷,
#           ZHJ=智慧记+运营系统, AIJXC=AI进销存, ZHJLS=智慧记零售

# ============================================================
# 本地存储路径（relative to ~/.lingeebuild/data/）
# ============================================================
local_storage:
  dir: "time-tracking/效贷"
  records_file: "records.jsonl"
  report_file: "time_analytics_效贷.html"
  csv_file: "time_analytics_效贷.csv"

# ============================================================
# MySQL 数据库配置（storage_mode=mysql 时生效）
# ============================================================
# 所有测试人员共享同一个 MySQL 实例，实现多端实时同步。
# 首次使用前：
#   1. 在 MySQL 中执行 scripts/init_mysql.sql 创建数据库和表
#   2. 填写下方连接信息
#   3. 安装 Python 驱动：pip install pymysql pyyaml
mysql:
  host: "YOUR_MYSQL_HOST"         # ← 改为你的 MySQL 服务器地址
  port: 3306                      # 端口
  user: "YOUR_USERNAME"           # ← 改为你的 MySQL 用户名
  password: "YOUR_PASSWORD"       # ← 改为你的 MySQL 密码
  database: "YOUR_DATABASE"       # ← 改为你的数据库名
  table: "time_tracking"          # 表名（无需修改）
  charset: "utf8mb4"              # 字符集（无需修改）

# ============================================================
# HTML 报告存储配置
# ============================================================
# 查看统计时生成的 HTML 报告存放位置。
# 本地路径由 generate_time_analytics.py 自动生成到 ~/.lingeebuild/data/ 下。
report_storage:
  local_dir: "~/.lingeebuild/data/time-tracking/效贷/"

# ============================================================
# 参考时间表（每步完成后展示给员工参考）
# 员工可采纳参考值，也可自行反馈实际节省时间
# ============================================================
reference_times:
  - step_code: "01"
    step_name: "文档整理"
    min_hours: 2.0
    max_hours: 4.0
    unit: "小时"
    basis: "按文档数量浮动，5个以上文档取上限"

  - step_code: "02"
    step_name: "需求评审"
    min_hours: 2.0
    max_hours: 3.0
    unit: "小时"
    basis: "6维度评审（完整性/一致性/边界/异常/优先级/可测性）"

  - step_code: "04"
    step_name: "生成测试点"
    min_hours: 3.0
    max_hours: 5.0
    unit: "小时"
    basis: "按需求复杂度浮动，涉及多系统交互取上限"

  - step_code: "06"
    step_name: "用例细化"
    min_hours: 4.0
    max_hours: 8.0
    unit: "小时"
    basis: "按用例数量浮动，100条以上取上限，可用人天"

  - step_code: "07"
    step_name: "知识入库"
    min_hours: 1.0
    max_hours: 2.0
    unit: "小时"
    basis: "总结+差异对比+精华提炼+归档"

# ============================================================
# 强制规则
# ============================================================
rules:
  mandatory: true                     # 每步必须反馈，不可跳过
  allow_skip: false                   # 不允许跳过
  require_confirmation: true          # 保存前必须二次确认
  unit_options:                       # 员工可用的反馈单位
    - "小时"
    - "人天"
  person_day_to_hours: 8.0           # 1人天 = 8小时
  storage_unit: "hours"              # 底层存储统一为小时
  display_unit: "person_days"        # 报告展示以人天为主

# ============================================================
# 会话缓存
# ============================================================
session_cache:
  cache_fields:                       # 首次填写后缓存，后续步骤无需重复
    - employee
    - user_story
  cache_duration: "session"           # 会话级缓存
